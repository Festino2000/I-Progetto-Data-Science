\contentsline {figure}{\numberline {2.5}{\ignorespaces A sinistra: varianza spiegata singola e cumulativa dalla PCA. A destra: Heatmap di Comunalità (\% di varianza preservata per ciascuna feature al variare di $k=1\dots 7$).}}{19}{figure.caption.19}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Heatmap della Matrice dei Pesi (\emph {Loadings}) delle 5 Componenti Principali ottime (\texttt {PC1}--\texttt {PC5}).}}{20}{figure.caption.21}%
