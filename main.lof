\contentsline {figure}{\numberline {1.1}{\ignorespaces Panoramica demografica dell'intero dataset ($N = 1.547.896$ utenti, 13--65 anni): distribuzione per età con isolamento della coorte dei minorenni ($N = 146.258$, $9,45\%$), ripartizione per contesto abitativo e genere, e andamento del tempo attivo medio su Instagram e dello stress percepito per fascia d'età.}}{2}{figure.caption.5}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Impatto della validazione dei dati sui $146.258$ minorenni (13--17 anni): confronto tra il file grezzo (\texttt {usage}, in arancione) e il file validato (\texttt {users}, in verde) per stato occupazionale, stato sentimentale e presenza di figli.}}{5}{figure.caption.8}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Profilo generale delle variabili di stile di vita nella coorte dei $146.258$ minorenni: distribuzione della qualità della dieta (\texttt {diet\_quality}, analizzata nel Capitolo~2), delle ore di sonno per notte e del tempo attivo su Instagram per singolo anno di età (approfondito nel Capitolo~\ref {cap:clustering}).}}{7}{figure.caption.10}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Distribuzione di diet\_quality prima di applicare le tecniche di sampling}}{10}{figure.caption.11}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Distribuzione di diet\_quality dopo il sampling}}{11}{figure.caption.12}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Matrice di correlazione dopo le operazioni di sampling}}{11}{figure.caption.13}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Distribuzioni univariate con curva di densità KDE, media e mediana per le principali feature comportamentali e psicologiche ($N = 146.258$ minorenni).}}{20}{figure.caption.18}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Analisi bivariata: esposizione giornaliera a Instagram contro Stress Percepito ($r = +0,850$), Felicità Dichiarata ($r = -0,385$) e distribuzione per fascia clinica di stress.}}{21}{figure.caption.19}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Matrice di correlazione di Pearson sulle 19 feature numeriche iniziali ($N = 146.258$ minorenni).}}{22}{figure.caption.20}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces A sinistra: matrice di correlazione post-scrematura sulle 7 Feature Core. A destra: stile di navigazione (Sessioni/Giorno contro Durata Media Sessione, colorato per punteggio di Stress).}}{23}{figure.caption.22}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces A sinistra: varianza spiegata singola e cumulativa dalla PCA. A destra: Heatmap di Comunalità (\% di varianza preservata per ciascuna feature al variare di $k=1\dots 7$).}}{24}{figure.caption.23}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Heatmap della Matrice dei Pesi (\emph {Loadings}) delle 5 Componenti Principali ottime (\texttt {PC1}--\texttt {PC5}).}}{25}{figure.caption.25}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Selezione del numero ottimo di cluster $k$ per K-Means: Metodo del Gomito (WCSS), Riduzione marginale \% della WCSS e andamento del Silhouette Score ($k=2\dots 8$).}}{26}{figure.caption.27}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Visualizzazione geometrica dei 3 cluster K-Means: proiezione 2D PCA, 3D PCA e iperpiano discriminante 2D LDA.}}{27}{figure.caption.29}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Profilazione semantica dei 3 Cluster K-Means ($N = 146.258$ minorenni): distribuzione percentuale, Heatmap Z-Score dei centroidi e Radar Chart dei percentili.}}{27}{figure.caption.30}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces A sinistra: distribuzione dei Silhouette Score per cluster ($k=3$). A destra: allineamento percentuale tra i cluster non supervisionati e le 3 classi di Rischio Stress (Opzione A1).}}{28}{figure.caption.32}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces DBSCAN: curva $k$-Distance (a sinistra), Heatmap del Silhouette Score sui cluster validi (al centro) e Heatmap del numero di cluster e percentuale di Outlier \texttt {-1} (a destra).}}{29}{figure.caption.34}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces DBSCAN ($\varepsilon =0,60, \text {min\_samples}=10$): proiezione 2D PCA, 3D PCA e caratterizzazione degli Outlier (\texttt {-1}) tramite distribuzione di \texttt {posts\_created\_per\_week}.}}{29}{figure.caption.35}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces HDBSCAN: estrazione macro-stabile \texttt {EOM} in 2D PCA (a sinistra), grado di certezza/probabilità in 3D PCA (al centro) ed estrazione dei 3 nuclei archetipici puri tramite metodo \texttt {Leaf} (a destra).}}{30}{figure.caption.37}%
